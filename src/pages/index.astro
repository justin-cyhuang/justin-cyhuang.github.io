---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import RepoCard from '../components/RepoCard.astro';
import SkillCounter from '../components/islands/SkillCounter.tsx';
import { fetchRepos } from '../lib/github';

const categorized = await fetchRepos();
---
<BaseLayout>

  <section id="intro">
    <h2>👋 Hi, I'm Justin</h2>
    <p>
      這裡是我的工作棚 — 我在一台 Raspberry Pi 4 上跑
      <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener">Hermes Agent</a>
      已經半年了，這頁是給自己跟好奇的人看的。
    </p>
    <p>
      下面會放：(1) 我現在最常用的 daily workflow，(2) 我寫的 / 在玩的 repository，
      (3) 一個小小的互動 demo，證明這站不是純靜態。
    </p>
  </section>

  <section id="latest">
    <h2>🍳 Latest Thing — 台灣司法判例筆記上線</h2>
    <p>
      GitHub Pages 新增 <strong>台灣司法判例筆記</strong> — 整理最近讀過覺得有趣的判決，
      依<strong>民事 / 刑事 / 行政</strong>分頁，子分類用<strong>請求權基礎、罪名或處分依據法條</strong>篩選。
      每個案例把<strong>一審到最終審</strong>判決收在同一張卡片方便對照，並附上司法院裁判書查詢系統的<strong>全文直接連結</strong>。
      首發收錄「大夜班店員燕麥奶拿鐵業務侵占案」（士林地院一審有罪 → 高等法院二審改判無罪定讞，
      判決書罕見以旁論痛批雇主「以刑逼民」）。
    </p>
    <p>
      其他近期專案：<strong>ComfyUI 升級指南</strong>（Portable 版升級流程、版本選擇、備份回退），
      <strong>Pillow Studio</strong> 馬克杯 3D 預覽（Blender 5.0 + atan2 shader 環繞貼圖）、
      <strong>AI Governance 知識庫</strong>（619 檔 / 4.1 MB，涵蓋 TW/EU/US/CN/JP 等 19 份法規）。
    </p>
    <p>
      底層仍是 <strong>Hermes on Pi 4</strong> — 8GB RAM，Discord 前端，
      主模型 claude-sonnet-5 (copilot)，背景任務用 claude-opus-4.8。
      每天早上 08:00 推 10 則跨來源新聞 + 台中天氣到 Discord。
    </p>
    <p>
      想試？官網在
      <a href="https://hermes-agent.nousresearch.com/" target="_blank" rel="noopener">hermes-agent.nousresearch.com</a>。
    </p>
    <p class="updated">最後更新：2026-07-06 CST</p>
  </section>

  <section id="workflows">
    <h2>🔁 Daily Workflows</h2>

    <SectionCard title="跨來源新聞日報" icon="📰">
      <p>
        Cron 每天 08:00 拉 BBC World / CNBC / NHK 的 RSS，交叉比對主軸事件，
        產出 10 則 bilingual headline + 台中天氣，
        bot 直接 push 到 Discord、同時備份成 Markdown 進 Obsidian。
      </p>
    </SectionCard>

    <SectionCard title="Pi 4 系統看門狗" icon="🩺">
      <p>
        記憶體 / 磁碟 / CPU 溫度三個 watchdog 每 5 分鐘跑一次，
        無事靜音，超過閾值才丟 Discord alert。寫成 no-agent cron job，零 LLM 開銷。
      </p>
    </SectionCard>

    <SectionCard title="/goal Loop" icon="🎯">
      <p>
        Hermes 內建的 goal-judge loop — 給一個目標、設 max_turns，
        小模型（gpt-4o-mini）當裁判每輪判 done/continue/pause，
        我把它當「自動跑 plan」的引擎用，這頁就是它跑出來的。
      </p>
    </SectionCard>

    <SectionCard title="Obsidian Vault 整合" icon="📓">
      <p>
        台電電價、研究筆記、新聞日報通通往 Vault 倒，
        Hermes 知道路徑、能搜尋、能 append，把 LLM context 跟長期知識縫起來。
      </p>
    </SectionCard>
  </section>

  <section id="guides">
    <h2>📚 Guides & Technical Notes</h2>
    <SectionCard title="台灣司法判例筆記" icon="⚖️">
      <p>
        整理最近讀過覺得有趣的台灣司法判決，依<strong>民事 / 刑事 / 行政</strong>分頁，
        子分類用<strong>請求權基礎、罪名或處分依據法條</strong>篩選。
        每個案例把<strong>一審到最終審</strong>的判決收在同一張卡片方便對照，
        並附上<strong>司法院裁判書查詢系統</strong>的判決全文直接連結。
      </p>
      <p style="margin-top: 0.75rem;">
        <a href="/case-law/" style="font-weight: 600;">→ 瀏覽司法判例筆記</a>
      </p>
    </SectionCard>
    <SectionCard title="ComfyUI Stable Diffusion 使用指南" icon="🎨">
      <p>
        完整的 SD3.5 工作流程：基礎設定、Prompting 技巧、圖像編輯、<strong>擴圖 (Outpainting)</strong>、
        ControlNet 引導、<strong>多解析度配置</strong>（Large/Medium/Turbo 完整對照）、VRAM 優化。
        涵蓋從基礎到進階的所有主題，拆分為 7 個獨立頁面方便查閱。
      </p>
      <p style="margin-top: 0.75rem;">
        <a href="/comfyui-sd-guide/" style="font-weight: 600;">→ 閱讀完整指南</a>
      </p>
    </SectionCard>
  </section>

  <section id="projects">
    <h2>📦 Projects & Repositories</h2>
    <p style="color: var(--text-muted); font-size: 0.9rem;">
      從 GitHub API build-time 抓的，每次重新部署會更新。
    </p>
    {categorized.map((cat) => (
      <div class="repo-group">
        <h3>{cat.category}</h3>
        {cat.repos.map((r) => <RepoCard repo={r} />)}
      </div>
    ))}
  </section>

  <section id="featured-project">
    <h2>🛋️ Pillow Studio — 3D Interactive Demo</h2>
    <p>
      在瀏覽器裡操作從 Blender export 出來的真實 mesh — 
      <strong>抱枕</strong>（23,522 頂點）和<strong>馬克杯</strong>（59,000+ 面），
      上傳自己的圖片即時預覽印刷效果。使用 Three.js + 自製 shader，純前端渲染，
      桌機和行動裝置都能流暢執行。
    </p>
    <p>
      支援三種布料材質（棉/麻/絲絨）、列印面積縮放、四種背景模式，
      馬克杯還有杯身 + 杯底獨立圖案上傳與裁切功能。
    </p>
    <p>
      <a href="/pillow-studio/" style="font-weight: 600; font-size: 1.05rem;">→ 打開 Pillow Studio 互動展示</a>
    </p>
  </section>

  <section id="demo">
    <h2>🧪 React Island Demo</h2>
    <p>
      下面這顆按鈕是 React 元件（Astro Island），用 <code>client:visible</code> 指令，
      只在它滑進 viewport 才會 hydrate。證明純靜態站也能嵌入互動元件。
    </p>
    <SkillCounter client:visible initial={0} />
  </section>

</BaseLayout>

<style>
  .repo-group { margin: 1rem 0 1.5rem; }
  .repo-group h3 {
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
  }
</style>
