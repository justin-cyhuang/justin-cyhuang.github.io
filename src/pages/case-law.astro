---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  cases,
  categoryLabels,
  type CaseCategory,
  type RulingOutcome,
} from '../data/case-law';

const categories: CaseCategory[] = ['civil', 'criminal', 'administrative'];

const countsByCategory: Record<CaseCategory, number> = {
  civil: cases.filter((c) => c.category === 'civil').length,
  criminal: cases.filter((c) => c.category === 'criminal').length,
  administrative: cases.filter((c) => c.category === 'administrative').length,
};

// 預設分頁：挑案例數最多的分類，避免第一次載入時剛好停在空分類
const defaultCategory: CaseCategory = categories.reduce(
  (best, cat) => (countsByCategory[cat] > countsByCategory[best] ? cat : best),
  categories[0],
);

// 每個分類底下依出現頻率排序的法條清單，供子分類篩選 chip 使用
function statutesForCategory(cat: CaseCategory): { statute: string; count: number }[] {
  const freq = new Map<string, number>();
  for (const c of cases) {
    if (c.category !== cat) continue;
    for (const s of c.statutes) {
      freq.set(s, (freq.get(s) ?? 0) + 1);
    }
  }
  return [...freq.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hant'))
    .map(([statute, count]) => ({ statute, count }));
}

const outcomeLabels: Record<RulingOutcome, string> = {
  favorable: '有利',
  unfavorable: '不利',
  neutral: '中性/其他',
};

const totalCases = cases.length;
const lastUpdated = cases.length
  ? [...cases].sort((a, b) => b.dateAdded.localeCompare(a.dateAdded))[0].dateAdded
  : '—';
---

<BaseLayout
  title="台灣司法判例筆記 — Justin's Workshop"
  description="整理近期讀過覺得有趣的台灣司法判例，依民事/刑事/行政分頁，並依請求權基礎或罪名分類，附司法院判決全文直接連結。"
>
  <article class="guide">
    <header class="guide-header">
      <h1>⚖️ 台灣司法判例筆記</h1>
      <p class="subtitle">整理最近讀過覺得有趣的判決 — 各審級判決都收在同一張卡片，附司法院判決全文直接連結</p>
      <p class="meta">
        <span class="version">收錄 {totalCases} 個案例</span> ·
        <span class="updated">最後更新：{lastUpdated}</span>
      </p>
    </header>

    <div class="callout info">
      <strong>💡 這頁怎麼看</strong><br />
      上面分頁先選<strong>民事 / 刑事 / 行政</strong>，下面的標籤是該分類底下出現過的<strong>請求權基礎／罪名／處分依據法條</strong>，
      點了會篩選只顯示引用該法條的案例。每張卡片把<strong>一審到最終審</strong>的判決都放在一起，方便直接對照審級之間的翻轉，
      每個審級旁邊都有司法院裁判書查詢系統的<strong>全文直接連結</strong>。
    </div>

    <!-- 主分頁：民事 / 刑事 / 行政 -->
    <div class="tab-bar" role="group" aria-label="依案件類型篩選" data-default-category={defaultCategory}>
      {categories.map((cat) => (
        <button
          type="button"
          class="tab-btn"
          data-category={cat}
          aria-pressed="false"
        >
          {categoryLabels[cat]} <span class="tab-count">{countsByCategory[cat]}</span>
        </button>
      ))}
    </div>

    <!-- 子分類：依法條篩選（每個分類各自一組，用 CSS 依目前分頁顯示/隱藏） -->
    {categories.map((cat) => {
      const statutes = statutesForCategory(cat);
      return (
        <div class="statute-chip-group" data-statute-group={cat} hidden>
          <button type="button" class="chip chip-all" data-statute="" aria-pressed="true">
            全部
          </button>
          {statutes.map(({ statute, count }) => (
            <button type="button" class="chip" data-statute={statute} aria-pressed="false">
              {statute} <span class="chip-count">{count}</span>
            </button>
          ))}
          {statutes.length === 0 && (
            <span class="chip-empty-hint">此分類尚無收錄案例</span>
          )}
        </div>
      );
    })}

    <!-- 案例卡片：全部先渲染出來，用 data-category / data-statutes 讓 JS 篩選顯示 -->
    <div class="case-grid">
      {cases.map((c) => (
        <article
          class="case-card"
          data-category={c.category}
          data-statutes={JSON.stringify(c.statutes)}
        >
          <header class="case-card-header">
            <span class={`category-badge category-${c.category}`}>{categoryLabels[c.category]}</span>
            <h2>{c.title}</h2>
          </header>

          <div class="case-statutes">
            {c.statutes.map((s) => (
              <span class="statute-tag">{s}</span>
            ))}
          </div>

          <p class="case-summary">{c.summary}</p>

          {c.tags && c.tags.length > 0 && (
            <div class="case-tags">
              {c.tags.map((t) => (
                <span class="tag">#{t}</span>
              ))}
            </div>
          )}

          <div class="instances-list">
            {c.instances.map((inst) => (
              <div class={`instance instance-${inst.outcome}`}>
                <div class="instance-top">
                  <span class="instance-level">{inst.level}</span>
                  <span class={`instance-outcome-badge outcome-${inst.outcome}`}>
                    {outcomeLabels[inst.outcome]}
                  </span>
                </div>
                <div class="instance-meta">
                  {inst.court} · {inst.caseNumber} · {inst.date}
                </div>
                <div class="instance-ruling">主文：{inst.ruling}</div>
                {inst.note && <div class="instance-note">{inst.note}</div>}
                <a class="instance-link" href={inst.link} target="_blank" rel="noopener">
                  → 查看司法院判決全文
                </a>
              </div>
            ))}
          </div>

          <p class="case-added">收錄於 {c.dateAdded}</p>
        </article>
      ))}
    </div>

    <p class="empty-state" hidden>這個分類目前還沒有符合篩選條件的案例，之後會陸續收錄。</p>

    <footer class="guide-footer">
      <p>
        <strong>資料來源：</strong>
        <a href="https://judgment.judicial.gov.tw/FJUD/default.aspx" target="_blank" rel="noopener">
          司法院裁判書查詢系統
        </a>
        （每筆判決都附上全文直接連結，可自行點入查證）
      </p>
      <p class="source">
        內容由 Hermes Agent 協助檢索司法院裁判書系統、比對新聞報導後整理，僅供學習與討論參考，非正式法律意見。
      </p>
    </footer>
  </article>
</BaseLayout>

<script>
  function initCaseLawFilters() {
    const tabBar = document.querySelector<HTMLElement>('.tab-bar');
    if (!tabBar) return;

    const tabButtons = Array.from(tabBar.querySelectorAll<HTMLButtonElement>('.tab-btn'));
    const chipGroups = Array.from(
      document.querySelectorAll<HTMLElement>('.statute-chip-group'),
    );
    const caseCards = Array.from(document.querySelectorAll<HTMLElement>('.case-card'));
    const emptyState = document.querySelector<HTMLElement>('.empty-state');

    let currentCategory =
      tabBar.dataset.defaultCategory || tabButtons[0]?.dataset.category || '';
    let selectedStatutes = new Set<string>(); // 空集合 = 不篩選（顯示全部）

    // 允許用網址 hash 指定分類，方便分享單一分頁的連結
    const hash = window.location.hash.replace('#', '');
    const validCategories = tabButtons.map((b) => b.dataset.category);
    if (hash && validCategories.includes(hash)) {
      currentCategory = hash;
    }

    function activeChipGroup(): HTMLElement | undefined {
      return chipGroups.find((g) => g.dataset.statuteGroup === currentCategory);
    }

    function render() {
      // 分頁按鈕高亮
      for (const btn of tabButtons) {
        const isActive = btn.dataset.category === currentCategory;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      }

      // 子分類 chip 群組：只顯示目前分頁對應的那組
      for (const group of chipGroups) {
        group.hidden = group.dataset.statuteGroup !== currentCategory;
      }

      // 卡片篩選：分類要吻合，且（沒有選任何法條 或 至少命中一個已選法條）
      let visibleCount = 0;
      for (const card of caseCards) {
        const cardCategory = card.dataset.category;
        let cardStatutes: string[] = [];
        try {
          cardStatutes = JSON.parse(card.dataset.statutes || '[]');
        } catch {
          cardStatutes = [];
        }

        const categoryMatch = cardCategory === currentCategory;
        const statuteMatch =
          selectedStatutes.size === 0 || cardStatutes.some((s) => selectedStatutes.has(s));

        const visible = categoryMatch && statuteMatch;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      if (emptyState) emptyState.hidden = visibleCount > 0;
    }

    tabBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab-btn');
      if (!btn || !btn.dataset.category) return;
      currentCategory = btn.dataset.category;
      selectedStatutes.clear(); // 換分頁時重置法條篩選
      history.replaceState(null, '', `#${currentCategory}`);
      render();
    });

    for (const group of chipGroups) {
      group.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
        if (!chip) return;
        const statute = chip.dataset.statute || '';

        if (statute === '') {
          // 「全部」：清空所有已選法條
          selectedStatutes.clear();
        } else {
          if (selectedStatutes.has(statute)) {
            selectedStatutes.delete(statute);
          } else {
            selectedStatutes.add(statute);
          }
        }

        // 更新 chip 的按下狀態
        const group2 = activeChipGroup();
        if (group2) {
          const allChip = group2.querySelector<HTMLButtonElement>('.chip-all');
          const otherChips = Array.from(
            group2.querySelectorAll<HTMLButtonElement>('.chip:not(.chip-all)'),
          );
          allChip?.setAttribute('aria-pressed', String(selectedStatutes.size === 0));
          allChip?.classList.toggle('active', selectedStatutes.size === 0);
          for (const c of otherChips) {
            const isSel = selectedStatutes.has(c.dataset.statute || '');
            c.setAttribute('aria-pressed', String(isSel));
            c.classList.toggle('active', isSel);
          }
        }

        render();
      });
    }

    render();
  }

  initCaseLawFilters();
</script>

<style>
  @import '../styles/guide-template.css';

  .guide-header {
    border-bottom-color: var(--border);
  }

  .callout {
    background: #e0f2fe;
    border-color: #0284c7;
  }

  /* === 主分頁 Tab Bar === */
  .tab-bar {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 2rem 0 1.25rem;
  }

  .tab-btn {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 2px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    border-color: var(--accent-strong);
  }

  .tab-btn.active {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: #0f1115;
  }

  .tab-count {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.85em;
    opacity: 0.8;
  }

  /* === 子分類 chips === */
  .statute-chip-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border);
  }

  /* hidden 屬性優先度必須贏過上面的 display:flex，否則篩選群組會全部同時顯示 */
  .statute-chip-group[hidden] {
    display: none;
  }

  .chip {
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .chip:hover {
    border-color: var(--accent-strong);
    color: var(--text);
  }

  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #0f1115;
    font-weight: 600;
  }

  .chip-count {
    opacity: 0.75;
    font-size: 0.9em;
  }

  .chip-empty-hint {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-style: italic;
    padding: 0.4rem 0;
  }

  /* === 案例卡片 === */
  .case-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case-card {
    background: white;
    border-radius: 10px;
    padding: 1.75rem;
    border: 1px solid #d1d5db;
  }

  .case-card-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .case-card-header h2 {
    margin: 0;
    font-size: 1.4rem;
    color: #1a1a1a;
  }

  .category-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    color: white;
    flex-shrink: 0;
  }

  .category-badge.category-civil { background: #2563eb; }
  .category-badge.category-criminal { background: #dc2626; }
  .category-badge.category-administrative { background: #7c3aed; }

  .case-statutes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .statute-tag {
    font-size: 0.8rem;
    background: #f3f4f6;
    color: #374151;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    border: 1px solid #e5e7eb;
  }

  .case-summary {
    color: #1a1a1a;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .case-tags {
    margin-bottom: 1.25rem;
  }

  .case-tags .tag {
    font-size: 0.8rem;
    color: #0284c7;
    margin-right: 0.6rem;
  }

  .case-added {
    margin: 1.25rem 0 0;
    font-size: 0.8rem;
    color: #6b7280;
    text-align: right;
  }

  /* === 審級時間軸 === */
  .instances-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .instance {
    padding: 1rem 1.25rem;
    border-radius: 6px;
    border-left: 4px solid;
    background: #f9fafb;
  }

  .instance-favorable {
    border-color: #16a34a;
    background: #f0fdf4;
  }

  .instance-unfavorable {
    border-color: #dc2626;
    background: #fef2f2;
  }

  .instance-neutral {
    border-color: #d97706;
    background: #fffbeb;
  }

  .instance-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .instance-level {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 1rem;
  }

  .instance-outcome-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    color: white;
  }

  .outcome-favorable { background: #16a34a; }
  .outcome-unfavorable { background: #dc2626; }
  .outcome-neutral { background: #d97706; }

  .instance-meta {
    font-size: 0.85rem;
    color: #4a4a4a;
    margin-bottom: 0.5rem;
  }

  .instance-ruling {
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }

  .instance-note {
    font-size: 0.9rem;
    color: #374151;
    line-height: 1.6;
    margin-bottom: 0.6rem;
  }

  .instance-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0284c7 !important;
    border-bottom: none !important;
  }

  .instance-link:hover {
    text-decoration: underline;
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 3rem 1rem;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .tab-bar {
      gap: 0.5rem;
    }

    .tab-btn {
      flex: 1 1 auto;
      text-align: center;
      padding: 0.55rem 0.75rem;
      font-size: 0.9rem;
    }

    .case-card {
      padding: 1.25rem;
    }

    .instance-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>
