---
import { fetchLatestNews } from '../lib/news';

const news = await fetchLatestNews();
---
{news && news.items.length > 0 && (
  <div class="news-card">
    <div class="news-card-head">
      <strong>🌍 每日國際新聞摘要</strong>
      <span class="news-date">{news.date}</span>
    </div>
    <ul class="news-list">
      {news.items.map((item) => (
        <li>
          <a href={item.link} target="_blank" rel="noopener">
            <span class="news-source">{item.source}</span>
            <span class="news-title">{item.title}</span>
          </a>
          <p class="news-excerpt">{item.excerpt}</p>
        </li>
      ))}
    </ul>
    <p class="news-note">
      Cron 每天 08:00 自動產生完整版（10 則 + 台中天氣），本卡片只顯示前 5 則精選摘要。
    </p>
  </div>
)}
{(!news || news.items.length === 0) && (
  <div class="news-card news-empty">
    <p>目前沒有新聞快照，稍後再回來看看。</p>
  </div>
)}

<style>
  .news-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }
  .news-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .news-date {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .news-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .news-list li:last-child { border-bottom: none; }
  .news-list a {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    border-bottom: none;
  }
  .news-source {
    flex-shrink: 0;
    font-size: 0.85rem;
  }
  .news-title {
    font-weight: 600;
    color: var(--text);
  }
  .news-list a:hover .news-title {
    color: var(--accent);
  }
  .news-excerpt {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .news-note {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .news-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
